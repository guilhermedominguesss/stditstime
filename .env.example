# Copie para .env.local (local) ou cadastre na Vercel: Project Settings > Environment Variables.
# Depois de mudar qualquer variável na Vercel, faça REDEPLOY (o Vite grava os valores no build).

# --- Front (vão para o navegador; todas são públicas por desenho) ---
# Supabase do painel. Aceita com ou sem o prefixo VITE_ (só estes dois nomes).
# A chave PRECISA ser a "anon": se for a service role, o build falha de propósito.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Só dígitos: 55 + DDD + número. Sem ela, usa o padrão do config.ts (5541984804266).
VITE_WHATSAPP_NUMBER=
# Sem ela, usa o padrão do config.ts (1914116903334296), só em produção.
VITE_META_PIXEL_ID=
# Sem ela, usa o padrão do config.ts (https://thais-lac.vercel.app).
VITE_THAIS_STD_URL=

# --- Servidor (só no /api/capi; SEM prefixo VITE_, nunca vão ao navegador) ---
META_CAPI_TOKEN=
# Opcional: o Pixel ID (padrão 1914116903334296).
META_PIXEL_ID=
# Opcional: código da aba "Testar eventos" do Gerenciador de Eventos (apague depois do teste).
META_TEST_EVENT_CODE=

# A service role / secret key do Supabase NÃO entra neste projeto.
